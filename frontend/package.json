    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@blueprintjs/select": "^6.3.4",
    "@preact/signals-react": "^3.12.0",
    "molstar": "^5.11.0",
    "openchemlib": "^9.25.0",
    "react": "^19.2.8",
    "react-cheminfo": "^0.19.0",
    "react-dom": "^19.2.8",
    "react-ocl": "^8.7.2",
    "react-science": "^23.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
