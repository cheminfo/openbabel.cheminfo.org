{
  "name": "openbabel-frontend",
  "version": "0.0.0",
  "description": "Web UI for the openbabel conversion service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview --host 0.0.0.0",
