{
  "name": "openbabel-backend",
  "version": "0.0.0",
  "description": "Chemical file format conversion API, backed by OpenBabel",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env src/server.ts",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.0",
    "react-cheminfo": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "vitest": "^4.1.10"
  }
}
