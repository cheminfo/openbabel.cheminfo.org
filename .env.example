# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# Port on which the service listens. The Vite dev server uses PORT + 1.
PORT=20808

# Where the site is served from, written into the canonical address and the
# social card of every page. Unset derives it from the request, which is only
# right when TRUST_PROXY names the proxy — behind one, set it.
# SITE_URL=https://openbabel.cheminfo.org

# The reverse proxies whose X-Forwarded-For is believed: an address, a CIDR
# range, or a comma separated list of either. Leave unset when nothing proxies
# this service. `true` believes any peer and is only safe when the port is
# unreachable except through the proxy.
# TRUST_PROXY=192.168.1.5

# Audience measurement snippet, injected at the end of the served page's
# <head> exactly as written. Unset means nothing is loaded, so a dev run and a
# staging deployment count nothing. The id below is a placeholder: take this
# site's own from the datami dashboard — never copy another project's.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="00000000-0000-0000-0000-000000000000"></script>

# Maximum number of obabel conversions running in parallel.
MAX_PARALLEL_CONVERSIONS=4

# Maximum number of conversions waiting in the queue before the API replies 503.
MAX_QUEUED_CONVERSIONS=32

# Time in milliseconds after which a running conversion is killed.
CONVERSION_TIMEOUT_MS=2000

# Path to the obabel binary. Leave empty inside the Docker image (auto-detected).
# BABEL=/opt/homebrew/bin/obabel

# Cloudflare Tunnel token (only required for the cloudflared compose variant).
# TUNNEL_TOKEN=
